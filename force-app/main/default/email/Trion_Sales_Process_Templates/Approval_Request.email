<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style=""><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial">{!Approval_Request__c.OwnerFullName} has entered a decision for the following Opportunity:</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="arial"><br></font></div><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Client</b><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">:&nbsp;</span><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">{!Approval_Request__c.Client__c}</span><br><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Opportunity Owner:</b>&nbsp;</span><font face="arial" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">{!Approval_Request__c.Opportunity_Owner__c}</font><br><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Request</b><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">:&nbsp; {!Approval_Request__c.Approval_Request__c}&nbsp;</span><br><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Decision</b><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">:&nbsp;{!Approval_Request__c.Approval_Decision__c}</span><br><b style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Decision made by</b><span style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">:&nbsp;</span><font face="arial">{!Approval_Request__c.Approved_Denied_by__c}</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><b>Notes</b>:&nbsp;{!Approval_Request__c.Comments__c}</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; text-align: left;">To view the Opportunity record, click&nbsp;<a href="https://trion.lightning.force.com/lightning/r/Opportunity/{!Approval_Request__c.OpportunityId__c}/view">here</a>.</div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; text-align: left;"><span style="font-size: 12pt;">To view the Proposal record, click </span><a href="https://trion.lightning.force.com/lightning/r/Proposal__c/{!Approval_Request__c.ProposalId__c}/view" style="font-size: 12pt;">here</a><span style="font-size: 12pt;">.&nbsp;</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br></div>]]></td>
