    <rules>
        <fullName>ADMIN FEE</fullName>
        <actions>
            <name>PER_CHECK_ANNUAL_ADMIN_FEE</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND(
  OR(
    ISPICKVAL(Administrative_Fee_Type__c, &quot;Per Check&quot;),
    ISPICKVAL(Administrative_Fee_Type__c, &quot;Annual&quot;)
  ),
  VALUE($Label.Workflow_Switch) != 1
)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Client Presentation Generated</fullName>
        <actions>
            <name>Proposal_Generated_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>ISCHANGED( Version__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Contract Generated Date</fullName>
        <actions>
            <name>Contract_Generated_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Proposal__c.Contract_Generated_Date__c</field>
            <operation>equals</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Proposal__c.Stage__c</field>
            <operation>equals</operation>
            <value>Contract</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>EPLI</fullName>
        <actions>
            <name>EPLI</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Proposal__c.EPLI_Cost__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Gross Wages Admin Fee</fullName>
        <actions>
            <name>Gross_Wages_Admin_Fee</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Proposal__c.Override_Gross_Wages_Admin_Fee__c</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <criteriaItems>
            <field>Proposal__c.Total_of_Employees__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
        <criteriaItems>
            <field>Proposal__c.Total_Gross_Wages__c</field>
            <operation>greaterThan</operation>
            <value>0</value>
        </criteriaItems>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>New Pricing Sheet Version</fullName>
        <actions>
            <name>Retrieve_Doc_Id</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>ISCHANGED( Version__c )</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Opportunity Close Date</fullName>
        <actions>
            <name>Opp_Close_Date_30_days_from_contract</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND(
ISCHANGED( Contract_Generated_Date__c ), Opportunity__r.CloseDate - TODAY()  &lt; 30)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>POLICY EXPIRATION</fullName>
        <actions>
            <name>Current_Policy_Expiring</name>
            <type>Alert</type>
        </actions>
        <active>false</active>
        <criteriaItems>
            <field>Proposal__c.Current_Policy_Expiration_Date__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Opportunity.IsClosed</field>
            <operation>equals</operation>
            <value>False</value>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
        <workflowTimeTriggers>
            <offsetFromField>Proposal__c.Current_Policy_Expiration_Date__c</offsetFromField>
            <timeLength>-14</timeLength>
            <workflowTimeTriggerUnit>Days</workflowTimeTriggerUnit>
        </workflowTimeTriggers>
    </rules>
    <rules>
        <fullName>PROPOSAL%3AOpportunity Close Date</fullName>
        <actions>
            <name>Proposal_Opp_Close_Date</name>
            <type>FieldUpdate</type>
        </actions>
        <active>false</active>
        <formula>AND(
ISCHANGED(Proposal_Generated_Date__c ), Opportunity__r.CloseDate - TODAY()  &lt; 30)</formula>
        <triggerType>onAllChanges</triggerType>
    </rules>
    <rules>
        <fullName>Presentation Deck</fullName>
        <actions>
            <name>Opp_Stage_Client_Value_Proposition</name>
