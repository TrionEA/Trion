    <formulas>
        <name>AdminfeeperCheckannual</name>
        <dataType>Currency</dataType>
        <expression>IF(
ISPICKVAL( {!$Record.Administrative_Fee_Type__c}, &quot;Per Check&quot;), {!$Record.Per_Check_Admin_Fee__c} ,
IF(
ISPICKVAL( {!$Record.Administrative_Fee_Type__c}, &quot;Annual&quot;),{!$Record.Admin_Fee_Annual__c}, NULL))</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>CloseDatevalue</name>
        <dataType>Date</dataType>
        <expression>DATEVALUE({!$Record.Contract_Generated_Date__c}) + 30</expression>
    </formulas>
    <formulas>
        <name>GrossWagesAdminFee</name>
        <dataType>Number</dataType>
        <expression>({!$Record.Total_of_Employees__c} * 1000) / {!$Record.Total_Gross_Wages__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>IsGeneratedDateChangedAndWithin30Days</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Proposal_Generated_Date__c}) &amp;&amp;
(
  {!$Record.Opportunity__r.CloseDate} - TODAY() &lt; 30
)</expression>
    </formulas>
    <formulas>
        <name>IsversionChanged</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Version__c})</expression>
    </formulas>
    <formulas>
        <name>opportunityclosedatecon</name>
        <dataType>Boolean</dataType>
        <expression>ISCHANGED({!$Record.Contract_Generated_Date__c}) &amp;&amp;
(
  {!$Record.Opportunity__r.CloseDate} - TODAY() &lt; 30
)</expression>
    </formulas>
    <formulas>
