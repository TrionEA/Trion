    <recordUpdates>
        <name>Copy_1_of_Updating_Case_which_is_closed_and_less_than_30_days</name>
        <label>Copy 1 of Updating Case which is closed and less than 30 days</label>
        <locationX>407</locationX>
        <locationY>492</locationY>
        <filterLogic>and</filterLogic>
        <filters>
