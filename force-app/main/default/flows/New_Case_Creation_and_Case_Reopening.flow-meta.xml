<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>60.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Copy_1_of_Checking_related_case_is_closed_or_not</name>
        <label>Copy 1 of Checking related case is closed or not</label>
        <locationX>473</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_Case_is_closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Cheking_No_Of_Days</targetReference>
            </connector>
            <label>Copy 1 of Case is closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Copy_1_of_Cheking_No_Of_Days</name>
        <label>Copy 1 of Cheking No Of Days</label>
        <locationX>275</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Copy_1_of_Updating_Case_which_is_closed_and_less_than_30_days</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Of Days &lt;=2min</defaultConnectorLabel>
        <rules>
            <name>Copy_1_of_No_Of_Days_2min</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NoOfDays</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Copy_1_of_Create_case_record</targetReference>
            </connector>
            <label>Copy 1 of No Of Days &gt;2min</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>NoOfDays</name>
        <dataType>Number</dataType>
        <expression>ROUND((NOW() - DATETIMEVALUE({!$Record.Parent.ClosedDate})) * 24 * 60, 0)</expression>
        <scale>2</scale>
    </formulas>
    <interviewLabel>New Case Creation and Case Reopening {!$Flow.CurrentDateTime}</interviewLabel>
    <label>New Case Creation and Case Reopening</label>
    <processMetadataValues>
