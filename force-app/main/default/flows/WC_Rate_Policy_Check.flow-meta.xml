<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>63.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_if_Policy_Changed_and_Rate_is_Blank</name>
        <label>Check if Policy Changed and Rate is Blank</label>
        <locationX>446</locationX>
        <locationY>323</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>PolicyChangedAndRateBlank</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Policy__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>$Record.Policy__c</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Carrier_WC_Rate__r.Rate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Field_Update_Carrier_WC_Rate</targetReference>
            </connector>
            <label>PolicyChangedAndRateBlank</label>
        </rules>
        <rules>
            <name>ManualRateAndPerCapitaCharge</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Carrier_WC_Rate__r.Rate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Carrier_WC_Rate__r.Per_Capita_Charge__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Field_Update_PER_CAPITA_RATE</targetReference>
            </connector>
            <label>ManualRateAndPerCapitaCharge</label>
        </rules>
        <rules>
            <name>StateClassificationAndCarrierWCRate</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Carrier_WC_Rate__r.State_Classification__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Monopolistic</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Carrier_Rate__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Field_Update</targetReference>
            </connector>
            <label>StateClassificationAndCarrierWCRate</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>PERCAPITARATE</name>
        <dataType>Number</dataType>
        <expression>ROUND( ({!$Record.Carrier_WC_Rate__r.Per_Capita_Rate__c} * {!$Record.Total_Employees__c}) / {!$Record.Gross_Wages__c},4)</expression>
        <scale>4</scale>
    </formulas>
    <interviewLabel>WC Rate Policy Check {!$Flow.CurrentDateTime}</interviewLabel>
    <label>WC Rate Policy Check</label>
    <processMetadataValues>
