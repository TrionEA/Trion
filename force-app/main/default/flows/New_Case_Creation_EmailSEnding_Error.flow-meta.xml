    <formulas>
        <description>We will be modifying the headers based on the length.</description>
        <name>ModifiedHeaders</name>
        <dataType>String</dataType>
        <expression>IF({!HeadersLength}&gt;32000, LEFT({!$Record.Headers}, 31500)
&amp;
BR()
&amp;
{!Texttemplateforemailmessage}, {!$Record.Headers})</expression>
    </formulas>
    <formulas>
        <description>We will be modifying the html body based on the length.</description>
        <name>Modifiedhtmlbody</name>
