            <targetReference>Updating_Case_which_is_closed_and_less_than_2_days</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Of Days &lt;=2</defaultConnectorLabel>
        <rules>
            <name>No_Of_Days_2</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NoOfDays</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>2.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_case_record</targetReference>
            </connector>
            <label>No Of Days &gt;2</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>NoOfDays</name>
        <dataType>Number</dataType>
        <expression>TODAY()-{!ClosedDateField}</expression>
        <scale>2</scale>
    </formulas>
