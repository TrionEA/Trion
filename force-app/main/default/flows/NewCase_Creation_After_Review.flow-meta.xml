    <decisions>
        <name>Checking_related_case_is_closed_or_not</name>
        <label>Checking related case is closed or not</label>
        <locationX>517</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_is_closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Parent.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Closed</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Cheking_No_Of_Days</targetReference>
            </connector>
            <label>Case is closed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Cheking_No_Of_Days</name>
