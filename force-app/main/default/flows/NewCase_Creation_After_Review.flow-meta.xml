        <locationX>319</locationX>
        <locationY>384</locationY>
        <defaultConnector>
            <targetReference>Updating_Case_which_is_closed_and_less_than_30_days</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Of Days &lt;=30</defaultConnectorLabel>
        <rules>
            <name>No_Of_Days_30</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>NoOfDays</leftValueReference>
                <operator>GreaterThan</operator>
                <rightValue>
                    <numberValue>30.0</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_case_record</targetReference>
            </connector>
            <label>No Of Days &gt;30</label>
        </rules>
    </decisions>
