<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>49.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <constants>
        <description>Maximum sequence value.</description>
        <name>MAX_SEQUENCE_NUMBER</name>
        <dataType>Number</dataType>
        <value>
            <numberValue>25.0</numberValue>
        </value>
    </constants>
    <decisions>
        <description>Check for Sequence of Most Recently Closed Case Number</description>
        <name>Check_for_Sequence_of_Most_Recently_Closed_Case_Number</name>
        <label>Check for Sequence of Most Recently Closed Case Number</label>
        <locationX>540</locationX>
        <locationY>82</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Case_Seq_blank_or_max</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CaseSeq</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CaseSeq</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>MAX_SEQUENCE_NUMBER</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Case_Starting_Number</targetReference>
            </connector>
            <label>Case Seq blank or max</label>
        </rules>
        <rules>
            <name>Sequence_Number_isnt_blank_or_Max</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>CaseSeq</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>CaseSeq</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>MAX_SEQUENCE_NUMBER</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Increment_Last_Closed_Case_Seq_Number</targetReference>
            </connector>
            <label>Sequence Number isnt blank or Max</label>
        </rules>
    </decisions>
    <description>Closed Case Sequence Number</description>
    <formulas>
        <description>Case Sequence Plus 1</description>
        <name>CaseSequencePlus1</name>
        <dataType>Number</dataType>
        <expression>{!CaseSeq}+1</expression>
        <scale>0</scale>
    </formulas>
    <interviewLabel>Closed Case Sequence {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Closed Case Sequence Number</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>FREE_FORM_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Get Most Recently Closed Case</description>
        <name>Get_Most_Recently_Closed_Case</name>
        <label>Get Most Recently Closed Case</label>
        <locationX>407</locationX>
        <locationY>80</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Check_for_Sequence_of_Most_Recently_Closed_Case_Number</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Case_Sequence_Number__c</field>
            <operator>IsNull</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Id</field>
            <operator>NotEqualTo</operator>
            <value>
                <elementReference>Caseid</elementReference>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Closed</stringValue>
            </value>
        </filters>
        <object>Case</object>
        <outputAssignments>
            <assignToReference>CaseSeq</assignToReference>
            <field>Case_Sequence_Number__c</field>
        </outputAssignments>
        <sortField>ClosedDate</sortField>
        <sortOrder>Desc</sortOrder>
    </recordLookups>
    <recordUpdates>
        <description>Increment Last Closed Case Seq Number plus 1</description>
        <name>Increment_Last_Closed_Case_Seq_Number</name>
        <label>Increment Last Closed Case Seq Number</label>
        <locationX>549</locationX>
        <locationY>386</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Caseid</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Case_Sequence_Number__c</field>
            <value>
                <elementReference>CaseSequencePlus1</elementReference>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <recordUpdates>
        <description>Update Case Starting Number</description>
        <name>Update_Case_Starting_Number</name>
        <label>Update Case Starting Number</label>
        <locationX>774</locationX>
        <locationY>82</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Caseid</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Case_Sequence_Number__c</field>
            <value>
                <numberValue>1.0</numberValue>
            </value>
        </inputAssignments>
        <object>Case</object>
    </recordUpdates>
    <runInMode>DefaultMode</runInMode>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Get_Most_Recently_Closed_Case</targetReference>
        </connector>
    </start>
    <status>Obsolete</status>
    <variables>
        <name>Caseid</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>CaseSeq</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>true</isOutput>
        <scale>0</scale>
    </variables>
</Flow>
