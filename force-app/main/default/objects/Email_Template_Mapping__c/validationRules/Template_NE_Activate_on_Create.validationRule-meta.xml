<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Template_NE_Activate_on_Create</fullName>
    <active>true</active>
    <description>Email template cannot be activated on create</description>
    <errorConditionFormula>ISNEW() &amp;&amp; (TEXT(Status__c)  = &apos;Activate&apos; || TEXT(Status__c)  = &apos;Completed&apos;)</errorConditionFormula>
    <errorDisplayField>Status__c</errorDisplayField>
    <errorMessage>Email template cannot be &apos;Activated&apos; or &apos;Completed&apos; on creation</errorMessage>
</ValidationRule>
