<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Campaign_Should_be_in_creation_stage</fullName>
    <active>true</active>
    <errorConditionFormula>ISNEW() &amp;&amp; NOT(ISPICKVAL(Campaign_Stage__c, &apos;Creation&apos;))</errorConditionFormula>
    <errorMessage>Campaign should be in creation stage when creating the campaign</errorMessage>
</ValidationRule>
