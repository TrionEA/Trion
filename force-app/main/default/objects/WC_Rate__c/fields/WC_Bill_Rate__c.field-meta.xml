<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>WC_Bill_Rate__c</fullName>
    <formula>ROUND(
((Carrier_Rate__c * Mod_Calculator__c ) * Assessment_Fee__c)+ Carrier_Rate__c * Mod_Calculator__c,4)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Bill Rate (includes the State Assessment Fee and Surcharge if included is selected)
(Bill Rate * State Assessment Fee and Surcharge) + Bill Rate</inlineHelpText>
    <label>Bill Rate</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
