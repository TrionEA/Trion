<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Client_Instructions_for_Email_Payment</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISPICKVAL( Payroll_Submission_Method__c , &quot;Email&quot;),
ISBLANK( Client_Instructions_for_Email_Payment__c )
)</errorConditionFormula>
    <errorMessage>Enter the client instructions for Email Payroll Method</errorMessage>
</ValidationRule>
